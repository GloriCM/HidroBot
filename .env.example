# Copia a .env y rellena valores reales. Nunca subas .env al repositorio.

NODE_ENV=development

# --- Base de datos ---
# Local (perfil Compose "local"): apunta al servicio db en la red Docker.
DATABASE_URL=postgres://hidrobot:hidrobot@db:5432/hidrobot
POSTGRES_USER=hidrobot
POSTGRES_PASSWORD=hidrobot
POSTGRES_DB=hidrobot

# Producción: URL del PostgreSQL externo (sin servicio db).
# DATABASE_URL=postgres://usuario:clave@host:5432/hidrobot

# --- API ---
# Genera secretos largos y aleatorios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-chars
INGEST_TOKEN=cambia-esto-token-ingesta-min-16

# Detrás de Cloudflare / HTTPS público: true. En local HTTP puro: false.
COOKIE_SECURE=false
TRUST_PROXY=true

COMMAND_TTL_MINUTES=10
DEVICE_OFFLINE_MINUTES=15
READINGS_RETENTION_DAYS=90
ALERT_COOLDOWN_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Semilla demo (usuario + dispositivo). Solo local/dev. Nunca en producción.
SEED=0
# DEMO_DEVICE_KEY=opcional-clave-fija-para-el-dispositivo-demo

# Telegram opcional (si vacío, las alertas solo se guardan en DB)
TELEGRAM_BOT_TOKEN=
