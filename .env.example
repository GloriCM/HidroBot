# Copia a .env y rellena valores reales. Nunca subas .env al repositorio.

NODE_ENV=development

# --- Base de datos ---
DATABASE_URL=postgres://hidrobot:hidrobot@db:5432/hidrobot
POSTGRES_USER=hidrobot
POSTGRES_PASSWORD=hidrobot
POSTGRES_DB=hidrobot

# --- API ---
SESSION_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-chars
INGEST_TOKEN=cambia-esto-token-ingesta-min-16

COOKIE_SECURE=false
TRUST_PROXY=true

COMMAND_TTL_MINUTES=10
DEVICE_OFFLINE_MINUTES=15
READINGS_RETENTION_DAYS=90
ALERT_COOLDOWN_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

SEED=0

TELEGRAM_BOT_TOKEN=

# Push inmediato de comandos/config a Node-RED (red Docker interna).
# Si está vacío, los comandos quedan pending hasta la próxima telemetría.
NODERED_COMMAND_URL=http://nodered:1880/hidrobot/publish
NODERED_TOKEN=cambia-token-nodered
NODERED_TIMEOUT_MS=3000

# --- Solo en el contenedor Node-RED (no en la API) ---
# API_URL=http://api:3000
# MQTT_USER=
# MQTT_PASS=
# DEVICE_API_KEYS={"esp32-1":"clave-mostrada-al-vincular"}
