# Copia a .env y rellena valores reales. Nunca subas .env al repositorio.

NODE_ENV=development

# --- Base de datos ---
DATABASE_URL=postgres://hidrobot:hidrobot@db:5432/hidrobot
POSTGRES_USER=hidrobot
POSTGRES_PASSWORD=hidrobot
POSTGRES_DB=hidrobot

# --- API ---
SESSION_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-chars
INGEST_TOKEN=cambia-esto-token-ingesta-min-16

COOKIE_SECURE=false
TRUST_PROXY=true

COMMAND_TTL_MINUTES=10
DEVICE_OFFLINE_MINUTES=15
READINGS_RETENTION_DAYS=90
ALERT_COOLDOWN_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

SEED=0

TELEGRAM_BOT_TOKEN=

# --- Correo (nodemailer) — opcional; sin SMTP la API sigue y solo registra en logs ---
# Gmail (contraseña de aplicación): smtp.gmail.com, puerto 465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HidroBot <no-reply@tudominio.com>"
APP_URL=http://localhost:5173
MAIL_MAX_PER_DEVICE_PER_HOUR=5

# Brevo (ejemplo):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-login-brevo
# SMTP_PASS=clave-smtp-brevo

# Resend (ejemplo vía SMTP):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_tu_api_key

# Push inmediato de comandos/config a Node-RED (red Docker interna).
# Si está vacío, los comandos quedan pending hasta la próxima telemetría.
NODERED_COMMAND_URL=http://nodered:1880/hidrobot/publish
NODERED_TOKEN=cambia-token-nodered
NODERED_TIMEOUT_MS=3000

# --- Solo en el contenedor Node-RED (no en la API) ---
# API_URL=http://api:3000
# MQTT_USER=
# MQTT_PASS=
# CLEAR_RETAIN_MQTT_IDS=hb-542cfc
