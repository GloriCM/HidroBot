{
  "name": "hidrobot-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:create": "node-pg-migrate create --migration-file-language cjs",
    "seed": "node src/seed/demo.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.1",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  }
}
